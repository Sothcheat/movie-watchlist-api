# Copy to .env and fill in real values. .env is git-ignored.

NODE_ENV=development
PORT=3000

# PostgreSQL (see docker-compose.yml)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=movie_watchlist
DB_TEST_NAME=movie_watchlist_test

# JWT secrets: at least 32 characters each, and different from each other
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-32-plus-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-32-plus
JWT_REFRESH_TTL=7d

# TMDB API read access token (Settings > API > API Read Access Token)
TMDB_ACCESS_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
