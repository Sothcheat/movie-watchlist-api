# Copy to .env and fill in real values. .env is git-ignored.

NODE_ENV=development
PORT=3000

# PostgreSQL (see docker-compose.yml)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=movie_watchlist
DB_TEST_NAME=movie_watchlist_test

# JWT signing secrets, different from each other. HS256 needs 256 bits (OWASP), i.e. 32 random
# bytes = 64 hex characters. The app only enforces 32+ characters, so don't hand-type one.
# Generate each with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-32-plus-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-32-plus
JWT_REFRESH_TTL=7d
# Expired refresh-token rows are kept this long before the nightly purge deletes them (default 7d)
REFRESH_TOKEN_RETENTION=7d

# TMDB API read access token (Settings > API > API Read Access Token)
TMDB_ACCESS_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
